# Copy to .env (never committed). The same names are used as GitHub Actions secrets.
# All keys are free registrations.
FRED_API_KEY=            # https://fredaccount.stlouisfed.org/apikeys
EIA_API_KEY=             # https://www.eia.gov/opendata/register.php
COINGECKO_API_KEY=       # Demo key: https://www.coingecko.com/en/api/pricing (attribution required)
ESTAT_APP_ID=            # optional, Japan e-Stat: https://www.e-stat.go.jp/api/
# CI only: fine-grained PAT with contents:write on the private econ-data repo
DATA_REPO_TOKEN=
# HTTPS_PROXY=http://proxy.example:8080
